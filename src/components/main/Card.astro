---
import { projects } from "@cv";
import Bagde from "../shared/Bagde.astro";
import { TAGS } from "../data/Tags.ts";
import BtnUrl from "../main/BtnUrl.astro";
import CodeGithub from "~/icons/CodeGithub.astro";
import Link from "~/icons/Link.astro";

const tagsArray = Object.entries(TAGS);
---

<ul class="px-4 flex justify-center items-center flex-col rounded-none">
  {
    projects.map((project: any, projectIndex: number) => (
      <li class="card w-full md:card-side bg-base-100 mt-4 max-w-screen-lg mx-auto rounded-none border border-base-300 shadow-sm">
        
        {/* Lado Izquierdo: Imagen de Portada */}
        <div class="w-full md:w-1/2 relative group cursor-pointer" onclick={`window['modal_project_${projectIndex}'].showModal()`}>
          <img
            src={project.imgs && project.imgs.length > 0 ? project.imgs[0] : project.img}
            alt={project.name}
            class="w-full h-64 object-cover transition-filter duration-300 group-hover:brightness-75"
          />
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
            <span class="bg-black/60 text-white px-4 py-2 rounded-full text-sm backdrop-blur-sm">Ver galería ({project.imgs?.length || 1})</span>
          </div>
        </div>

        {/* Modal con el Carrusel Interno */}
        <dialog id={`modal_project_${projectIndex}`} class="modal">
          <div class="modal-box p-0 max-w-4xl bg-transparent shadow-none overflow-visible">
            
            {/* Botón para cerrar */}
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost absolute -top-10 right-0 text-white text-xl">✕</button>
            </form>

            <div class="carousel w-full h-[70vh] rounded-xl shadow-2xl">
              {
                project.imgs && project.imgs.length > 0 ? (
                  project.imgs.map((imgUrl: string, imgIndex: number) => (
                    <div id={`modal-${projectIndex}-slide${imgIndex}`} class="carousel-item relative w-full bg-black/20">
                      <img src={imgUrl} class="w-full h-full object-contain" alt={`${project.name} ${imgIndex}`} />
                      
                      {project.imgs.length > 1 && (
                        <div class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between">
                          <a href={`#modal-${projectIndex}-slide${imgIndex === 0 ? project.imgs.length - 1 : imgIndex - 1}`} 
                             class="btn btn-circle btn-md bg-black/40 border-none text-white hover:bg-black/80">❮</a>
                          <a href={`#modal-${projectIndex}-slide${imgIndex === project.imgs.length - 1 ? 0 : imgIndex + 1}`} 
                             class="btn btn-circle btn-md bg-black/40 border-none text-white hover:bg-black/80">❯</a>
                        </div>
                      )}
                    </div>
                  ))
                ) : (
                  <div class="carousel-item relative w-full">
                    <img src={project.img} class="w-full h-full object-contain" />
                  </div>
                )
              }
            </div>
          </div>
          <form method="dialog" class="modal-backdrop bg-black/80 backdrop-blur-sm">
            <button>close</button>
          </form>
        </dialog>

        {/* Cuerpo de la Tarjeta (Igual que antes) */}
        <div class="card-body w-full md:w-1/2">
          <h3 class="card-title text-xl font-bold">{project.name}</h3>

          <div class="flex flex-wrap gap-2">
            {project.technologies.map((skillName: string) => {
              const tagEntry = tagsArray.find(([_, tag]) => tag.name.toLowerCase() === skillName.toLowerCase());
              if (tagEntry) {
                const [_, tagData] = tagEntry;
                return (
                  <Bagde key={tagData.name} class={tagData.class}>
                    <span class="flex flex-row gap-1 items-center text-[10px] uppercase font-bold tracking-wider">
                      <tagData.icon class="w-3 h-3" />
                      {tagData.name}
                    </span>
                  </Bagde>
                );
              }
            })}
          </div>

          <p class="text-sm  mt-2">{project.description}</p>

          <div class="card-actions mt-auto pt-6 flex justify-end">
            {project.github && (
              <BtnUrl href={project.github} class="btn btn-ghost btn-sm border-base-300">
                <CodeGithub class="w-5 h-5" /> Code
              </BtnUrl>
            )}
            {project.demo && (
              <BtnUrl href={project.demo} class="btn btn-primary btn-sm px-6">
                <Link class="w-5 h-5" /> Preview
              </BtnUrl>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>